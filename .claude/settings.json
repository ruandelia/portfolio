{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "ask": ["Edit", "Write", "Bash"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/**)",
      "Edit(./Dockerfile)",
      "Edit(./nginx/**)",
      "Edit(./.github/**)",
      "Edit(./docs/infra/**)",
      "Bash(gcloud *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)"
    ]
  }
}