{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": ["Bash(npm install *)", "Bash(npm i *)", "Bash(npm uninstall *)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/**)",
      "Edit(./Dockerfile)",
      "Edit(./nginx/**)",
      "Edit(./.github/**)",
      "Edit(./docs/infra/**)",
      "Bash(gcloud *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git rebase *)"
    ]
  }
}